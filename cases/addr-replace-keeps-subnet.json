{
  "name": "addr-replace-keeps-subnet",
  "description": "add a second address then drop the first; still on-subnet throughout",
  "peer": {
    "subject_ip": "10.5.5.1/24",
    "peer_ip": "10.5.5.2/24",
    "probe": "10.5.5.2"
  },
  "setup": [
    "ip addr add 10.5.5.11/24 dev veth0"
  ],
  "action": {
    "kind": "shell",
    "spec": "ip addr del 10.5.5.1/24 dev veth0"
  },
  "expect": {
    "reachable_after": true,
    "established_after": false
  }
}
