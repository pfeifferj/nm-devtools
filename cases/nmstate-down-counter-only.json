{
  "name": "nmstate-down-counter-only",
  "slice": "nmstate",
  "origin": "generated",
  "split": "dev",
  "description": "request link-down with a counter rule that reaches no verdict",
  "peer": {
    "subject_ip": "10.5.5.1/24",
    "peer_ip": "10.5.5.2/24",
    "probe": "10.5.5.2"
  },
  "setup": [
    "nft add table inet f",
    "nft add chain inet f out \"{ type filter hook output priority 0; policy accept; }\"",
    "nft add rule inet f out ip daddr 10.5.5.2 counter"
  ],
  "action": {
    "kind": "nmstate",
    "spec": {
      "interfaces": [
        {
          "name": "veth0",
          "state": "down"
        }
      ]
    }
  },
  "expect": {
    "exit_code": 0,
    "reachable_before": true,
    "reachable_after": true,
    "established_before": true,
    "established_after": true,
    "bulk_before": true,
    "bulk_after": true
  }
}
