{
  "name": "route-blackhole-covered-by-specific",
  "slice": "route-blackhole",
  "origin": "handwritten",
  "split": "dev",
  "description": "blackhole the subnet while a host route to the peer still wins",
  "peer": {
    "subject_ip": "10.5.5.1/24",
    "peer_ip": "10.5.5.2/24",
    "probe": "10.5.5.2"
  },
  "setup": [
    "ip route add 10.5.5.2/32 dev veth0"
  ],
  "action": {
    "kind": "shell",
    "spec": "ip route replace blackhole 10.5.5.0/24"
  }
}
