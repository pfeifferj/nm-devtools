{
  "name": "nmstate-invalid-mtu-from-low",
  "slice": "nmstate",
  "origin": "handwritten",
  "split": "holdout",
  "description": "same rejected MTU apply as nmstate-invalid-mtu, starting from an MTU too low for full-size traffic",
  "peer": {
    "subject_ip": "10.5.5.1/24",
    "peer_ip": "10.5.5.2/24",
    "probe": "10.5.5.2"
  },
  "setup": [
    "ip link set veth0 mtu 1280"
  ],
  "action": {
    "kind": "nmstate",
    "spec": {
      "interfaces": [
        {
          "name": "veth0",
          "state": "up",
          "mtu": 999999
        }
      ]
    }
  }
}
