{
  "name": "link-change-mac",
  "slice": "link",
  "origin": "handwritten",
  "split": "holdout",
  "description": "change the MAC under an open flow, leaving the peer's ARP entry stale",
  "peer": {
    "subject_ip": "10.5.5.1/24",
    "peer_ip": "10.5.5.2/24",
    "probe": "10.5.5.2"
  },
  "setup": [],
  "action": {
    "kind": "shell",
    "spec": "ip link set veth0 address 02:11:22:33:44:55"
  }
}
