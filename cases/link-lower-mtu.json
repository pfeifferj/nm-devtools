{
  "name": "link-lower-mtu",
  "description": "lower the MTU well below the probe size",
  "peer": {
    "subject_ip": "10.5.5.1/24",
    "peer_ip": "10.5.5.2/24",
    "probe": "10.5.5.2"
  },
  "setup": [],
  "action": {
    "kind": "shell",
    "spec": "ip link set veth0 mtu 1280"
  },
  "expect": {
    "reachable_after": true,
    "established_after": true,
    "bulk_after": false
  }
}
