{
  "name": "link-mtu-restore",
  "description": "raise a lowered MTU back; repairs full-size traffic only",
  "peer": {
    "subject_ip": "10.5.5.1/24",
    "peer_ip": "10.5.5.2/24",
    "probe": "10.5.5.2"
  },
  "setup": [
    "ip link set veth0 mtu 1280"
  ],
  "action": {
    "kind": "shell",
    "spec": "ip link set veth0 mtu 1500"
  }
}
