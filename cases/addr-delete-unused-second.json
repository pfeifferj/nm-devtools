{
  "name": "addr-delete-unused-second",
  "split": "dev",
  "description": "remove a second address no flow is using",
  "peer": {
    "subject_ip": "10.5.5.1/24",
    "peer_ip": "10.5.5.2/24",
    "probe": "10.5.5.2"
  },
  "setup": [
    "ip addr add 10.6.6.1/24 dev veth0"
  ],
  "action": {
    "kind": "shell",
    "spec": "ip addr del 10.6.6.1/24 dev veth0"
  }
}
