{
  "name": "nmstate-down-host-route",
  "slice": "nmstate",
  "origin": "generated",
  "split": "holdout",
  "description": "down with a host route already covering the peer",
  "peer": {
    "subject_ip": "10.5.5.1/24",
    "peer_ip": "10.5.5.2/24",
    "probe": "10.5.5.2"
  },
  "setup": [
    "ip route add 10.5.5.2/32 dev veth0"
  ],
  "action": {
    "kind": "nmstate",
    "spec": {
      "interfaces": [
        {
          "name": "veth0",
          "state": "down"
        }
      ]
    }
  }
}
