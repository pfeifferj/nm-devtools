#!/usr/bin/env bash
# Build/deploy nmstatectl and apply config states. VM lifecycle is in testvm.
# Rawhide builds on the host; Stream 9/10 builds inside the guest from a
# writable virtiofs checkout, using rust/vm-target instead of the host target.
#
# Target VM via $TESTVM_DOMAIN (default nm-rawhide).
#
# Usage:
#   nmstate-vm build          cargo build --release nmstatectl
#   nmstate-vm deploy         build + install nmstatectl in the guest
#   nmstate-vm apply <state>  apply a YAML: a local path or a name in examples/
#   nmstate-vm show [iface]   nmstatectl show on the VM
#   nmstate-vm status         deployed nmstatectl version
#   nmstate-vm test [args]    deploy + run tests/integration in the VM (pytest args)
set -euo pipefail

DOMAIN="${TESTVM_DOMAIN:-nm-rawhide}"
case "$DOMAIN" in
  nm-rawhide-gnome) HOST=gnome-vm ;;
  nm-c10s) HOST=c10-vm ;;
  nm-c11s) HOST=c11-vm ;;
  nm-c9s) HOST=c9-vm ;;
  *) HOST=nm-vm ;;
esac
REPO="${NMSTATE_REPO:-$HOME/rh-src/nmstate}"
RUST="$REPO/rust"
BIN="$RUST/target/release/nmstatectl"
SRC=/mnt/nmstate
BUILD=$SRC/rust/vm-target
GUEST_BUILD=false
case "$DOMAIN" in nm-c9s|nm-c10s) GUEST_BUILD=true ;; esac

sh() { ssh "$HOST" "$@"; }

case "${1:-}" in
  show|status|"") ;;
  build) if $GUEST_BUILD; then testvm -d "$DOMAIN" claim "nmstate-vm build"; fi ;;
  deploy|apply|test) testvm -d "$DOMAIN" claim "nmstate-vm $1" ;;
esac

# nmstate is mounted on demand so existing cloud-init seeds need no changes.
# Refuse a different mount (or an empty directory) rather than building from
# the wrong source tree. The share must be writable for vm-target and tests.
check_source() {
  sh "mkdir -p $SRC &&
    (findmnt -rn -T $SRC -S nmstate -t virtiofs >/dev/null ||
      { ! mountpoint -q $SRC && mount -t virtiofs nmstate $SRC; }) &&
    findmnt -rn -T $SRC -S nmstate -t virtiofs >/dev/null &&
    test -w $SRC && test -f $SRC/rust/Cargo.toml" || {
    echo "cannot use $SRC on $HOST: nmstate virtiofs not mounted/writable, no Cargo.toml, or ssh failed" >&2
    return 1
  }
}

guest_build() {
  check_source
  sh "cd $SRC && CARGO_TARGET_DIR=$BUILD cargo build --release --bin nmstatectl --manifest-path rust/Cargo.toml"
}

host_build() { cargo build --release --bin nmstatectl --manifest-path "$RUST/Cargo.toml"; }

resolve_state() {
  local s="$1"
  for cand in "$s" "$REPO/examples/$s" "$REPO/examples/$s.yml"; do
    [ -f "$cand" ] && { echo "$cand"; return 0; }
  done
  echo "state not found: $s (tried path and examples/)" >&2; return 1
}

case "${1:-}" in
build)
  if $GUEST_BUILD; then guest_build; else host_build; fi
  ;;

deploy)
  if $GUEST_BUILD; then
    guest_build
    sh "install -m755 $BUILD/release/nmstatectl /usr/local/bin/nmstatectl && nmstatectl --version"
  else
    host_build
    scp "$BIN" "$HOST:/usr/local/bin/"
    sh "nmstatectl --version"
  fi
  ;;

apply)
  state=$(resolve_state "${2:?usage: nmstate-vm apply <state>}")
  scp "$state" "$HOST:/tmp/state.yml"
  sh "nmstatectl apply /tmp/state.yml"
  ;;

show)
  sh "nmstatectl show ${2:-}"
  ;;

status)
  sh "nmstatectl --version"
  ;;

test)
  shift
  # default target only when the caller didn't pass a path of their own
  args=$(printf '%q ' "$@")
  [[ " $* " == *" tests/"* ]] || args="tests/integration $args"
  if $GUEST_BUILD; then
    check_source
    sh "cd $SRC && CARGO_TARGET_DIR=$BUILD cargo build --all --release --manifest-path rust/Cargo.toml"
    sh "install -m755 $BUILD/release/nmstatectl /usr/local/bin/nmstatectl &&
      install -m755 $BUILD/release/libnmstate.so /usr/local/lib/libnmstate.so.2"
    sh "command -v pytest >/dev/null && command -v podman >/dev/null ||
      dnf install -y -q --refresh python3-pytest python3-pyyaml podman"
    sh "cd $SRC && LD_LIBRARY_PATH=/usr/local/lib PYTHONPATH=$SRC/rust/src/python pytest $args"
  else
    (cd "$RUST" && cargo build --all --release)
    scp "$BIN" "$HOST:/usr/local/bin/"
    # The python binding dlopens libnmstate.so.2.
    scp "$RUST/target/release/libnmstate.so" "$HOST:/usr/local/lib/libnmstate.so.2"
    rsync -a --delete "$REPO/tests" "$REPO/examples" "$RUST/src/python/libnmstate" \
      "$HOST:nmstate-tests/"
    sh "command -v pytest >/dev/null && command -v podman >/dev/null ||
      dnf install -y -q --refresh python3-pytest python3-yaml podman"
    sh "cd nmstate-tests && LD_LIBRARY_PATH=/usr/local/lib PYTHONPATH=\$PWD pytest $args"
  fi
  ;;

*)
  sed -n '2,16p' "$0"
  exit 1
  ;;
esac
