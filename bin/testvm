#!/usr/bin/env bash
# Lifecycle control for the nmtest libvirt VMs. Tool-agnostic: knows nothing
# about NetworkManager or nmstate, only the VMs and their snapshots.
# Deploy/apply live in the per-tool scripts (nm-vm, nmstate-vm).
#
# Each domain has its own MAC, pinned IP, and ssh alias, so they run concurrently:
#   nm-rawhide        198.51.100.16  ssh nm-vm     headless, patched NM + nmstate (default)
#   nm-rawhide-gnome  198.51.100.17  ssh gnome-vm  fresh Fedora Cloud rawhide + GNOME
#   nm-c10s           198.51.100.18  ssh c10-vm    headless CentOS Stream 10, NM dev build
#   nm-c11s           198.51.100.19  ssh c11-vm    headless CentOS Stream 11 (stub, no image yet)
#   nm-c9s            198.51.100.20  ssh c9-vm     headless CentOS Stream 9, NM dev build
#
# Pick a domain with `-d <name>` or $TESTVM_DOMAIN (default: nm-rawhide).
#
# Usage:
#   testvm [-d DOM] up           start the VM, wait for ssh (+cloud-init if seeded)
#   testvm [-d DOM] down         graceful shutdown
#   testvm [-d DOM] status       domain state + ssh reachability
#   testvm [-d DOM] rollback [s] revert to snapshot (default: baseline-known-good)
#   testvm [-d DOM] snapshot <n> create a snapshot (disk+RAM, brief pause)
#   testvm [-d DOM] snapshots    list snapshots
#   testvm domains               list known test domains, state, and ssh alias
#   testvm [-d DOM] wait         block until ssh (+cloud-init if seeded) is ready
#   testvm [-d DOM] console      serial console (exit: Ctrl+])
#   testvm [-d DOM] ssh [cmd...] ssh into the domain
#   testvm [-d DOM] claim [why]  mark the domain in use by this session
#   testvm [-d DOM] release      give the domain up
#
# up/down/rollback/snapshot claim the domain first and refuse while another
# live session holds it. The lease names the session ($TESTVM_OWNER, else
# $CLAUDE_CODE_SESSION_ID, else user@host); a lease whose pid is gone is
# taken over. TESTVM_FORCE=1 overrides.
set -euo pipefail

SNAP_DEFAULT=baseline-known-good
VIRSH=(virsh -c qemu:///system)
KNOWN=(nm-rawhide nm-rawhide-gnome nm-c10s nm-c11s nm-c9s)

DOMAIN="${TESTVM_DOMAIN:-nm-rawhide}"
if [ "${1:-}" = "-d" ]; then DOMAIN="$2"; shift 2; fi

host_for() {
  case "$1" in
    nm-rawhide-gnome) echo gnome-vm ;;
    nm-c10s) echo c10-vm ;;
    nm-c11s) echo c11-vm ;;
    nm-c9s) echo c9-vm ;;
    *) echo nm-vm ;;
  esac
}
HOST=$(host_for "$DOMAIN")
SSH_WAIT=(ssh -o BatchMode=yes -o ConnectTimeout=2 -o ServerAliveInterval=15 -o ServerAliveCountMax=3)

case "$DOMAIN" in */*|.*|"") echo "bad domain name: $DOMAIN" >&2; exit 1 ;; esac
LEASE_DIR="${XDG_RUNTIME_DIR:?needed for the domain lease}/testvm"
LEASE="$LEASE_DIR/$DOMAIN.lease"
ME="${TESTVM_OWNER:-${CLAUDE_CODE_SESSION_ID:-$(id -un)@$HOSTNAME}}"
# The pid of the session, not this shell: each Bash call from an agent is a
# new process, but the agent itself stays up for the lease's lifetime.
MY_PID="${CLAUDE_PID:-$PPID}"

lease_get() { sed -n "s/^$1=//p" "$LEASE" 2>/dev/null; }

lease_line() {
  if [ -e "$LEASE" ]; then
    echo "held by $(lease_get owner) since $(date -d "@$(lease_get since)" +%H:%M): $(lease_get reason)"
  else
    echo free
  fi
}

lease_blocked() {
  [ -e "$LEASE" ] || return 1
  [ "$(lease_get owner)" != "$ME" ] || return 1
  [ "${TESTVM_FORCE:-}" != 1 ] || return 1
  # kill -0 fails with EPERM on another user's live process; /proc does not.
  # ponytail: pid existence only; compare /proc/pid/stat start time if reuse bites
  local pid; pid=$(lease_get pid)
  if [ -z "$pid" ] || [ ! -d "/proc/$pid" ]; then
    echo "$DOMAIN: stale lease from $(lease_get owner) (pid gone), taking over" >&2
    return 1
  fi
  echo "$DOMAIN $(lease_line)" >&2
  return 0
}

# The reason is the last thing done to the domain through the wrappers;
# since is when this session took it.
lease_write() {
  local since
  since=$(date +%s)
  [ "$(lease_get owner)" != "$ME" ] || since=$(lease_get since)
  printf 'owner=%s\npid=%s\nsince=%s\nreason=%s\n' "$ME" "$MY_PID" "$since" "${1//$'\n'/ }" > "$LEASE.$$"
  mv -f "$LEASE.$$" "$LEASE"
}

# The lock lives only for the check-and-write, so a long `up` does not hold
# other sessions' claims.
claim() {
  mkdir -p "$LEASE_DIR"
  ( flock 9; lease_blocked && exit 1; lease_write "$1" ) 9>"$LEASE.lock" || exit 1
}

release() {
  [ -e "$LEASE" ] || return 0
  ( flock 9; lease_blocked && exit 1; rm -f "$LEASE" ) 9>"$LEASE.lock" || exit 1
}

wait_ssh() {
  for i in $(seq 1 90); do
    if "${SSH_WAIT[@]}" "$HOST" true 2>/dev/null; then
      echo "ssh up (attempt $i)"
      case "$DOMAIN" in
        nm-rawhide-gnome|nm-c9s|nm-c10s)
          echo "waiting for cloud-init"
          if ! "${SSH_WAIT[@]}" "$HOST" "timeout 5m cloud-init status --wait"; then
            echo "cloud-init failed on $DOMAIN" >&2
            return 1
          fi
          ;;
      esac
      return 0
    fi
    sleep 1
  done
  echo "timed out waiting for ssh" >&2; return 1
}

CMD="${1:-}"
case "$CMD" in
up|down|rollback|snapshot) claim "$CMD" ;;
esac

case "$CMD" in
up)
  case "$("${VIRSH[@]}" domstate "$DOMAIN" 2>/dev/null || true)" in
  running) ;;
  paused) "${VIRSH[@]}" resume "$DOMAIN" ;;
  *) "${VIRSH[@]}" start "$DOMAIN" ;;
  esac
  wait_ssh
  ;;

down)
  "${VIRSH[@]}" shutdown "$DOMAIN"
  ;;

status)
  "${VIRSH[@]}" domstate "$DOMAIN"
  "${SSH_WAIT[@]}" "$HOST" true 2>/dev/null && echo "ssh: up ($HOST)" || echo "ssh: down ($HOST)"
  echo "lease: $(lease_line)"
  ;;

rollback)
  snap="${2:-$SNAP_DEFAULT}"
  "${VIRSH[@]}" snapshot-revert "$DOMAIN" "$snap" --running
  wait_ssh
  ;;

snapshot)
  name="${2:?usage: testvm snapshot <name>}"
  "${VIRSH[@]}" snapshot-create-as "$DOMAIN" "$name"
  ;;

snapshots)
  "${VIRSH[@]}" snapshot-list "$DOMAIN"
  ;;

domains)
  for d in "${KNOWN[@]}"; do
    printf "%-18s %-10s ssh %-9s %s\n" "$d" "$("${VIRSH[@]}" domstate "$d" 2>/dev/null || echo undefined)" "$(host_for "$d")" "$(LEASE="$LEASE_DIR/$d.lease"; lease_line)"
  done
  ;;

claim)
  claim "${2:-claim}"
  ;;

release)
  release
  ;;

wait)
  wait_ssh
  ;;

console)
  exec "${VIRSH[@]}" console "$DOMAIN"
  ;;

ssh)
  shift
  ssh "$HOST" "${*:-}"
  ;;

*)
  sed -n '2,32p' "$0"
  exit 1
  ;;
esac
